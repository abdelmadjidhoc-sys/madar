# Copy this file to .env for local development (npm run setup-db, npm run dev).
# In production, set the same variable under Vercel → Project → Settings →
# Environment Variables — never commit the real value.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign member session cookies (see lib/auth.js). If it is
# missing, nobody can log in. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

ADMIN_SESSION_SECRET=long-random-string
