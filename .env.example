# Copy this file to .env for local development (npm run setup-db, npm run dev).
# In production, set the same variable under Vercel → Project → Settings →
# Environment Variables — never commit the real value.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin login for /adminmadar (see lib/auth.js). Set all three — if any is
# missing, nobody can log in. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_USERNAME=madar.admin
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_SESSION_SECRET=long-random-string
